# /etc/nordpress/env  (Rechte 640, Besitzer root:nordpress)
HOST=127.0.0.1
PORT=3001

# RDS: eigener DB-Benutzer, nicht der Hauptbenutzer postgres
DATABASE_URL=postgres://nordpress:<PASSWORT>@<RDS-ENDPUNKT>:5432/nordpress
# verschlüsselt und Zertifikat gegen die RDS-CA prüfen
DB_SSL=verify
DB_SSL_CA=/etc/nordpress/rds-global-bundle.pem

COOKIE_SECURE=true
SESSION_DAYS=7

# Medien in S3, Zugangsdaten kommen über die IAM-Rolle der Instanz
STORAGE=s3
S3_BUCKET=<BUCKET-NAME>
S3_REGION=eu-west-1
S3_PREFIX=media/
MAX_UPLOAD_MB=5

# Formulare: Absender der Benachrichtigungen (Standard, im Admin änderbar).
# Mit Resend-API-Key im Admin gehen Mails über Resend, sonst über Amazon SES
# (dann muss die Adresse in SES bestätigt sein, im Sandbox-Modus auch jeder Empfänger).
MAIL_FROM=<noreply@deine-domain.de>
# MAIL_REGION=eu-west-1      # Standard: S3_REGION
SITE_URL=https://<CLOUDFRONT-ODER-DOMAIN>
# FORM_LIMIT=5               # Einsendungen je IP in 10 Minuten
